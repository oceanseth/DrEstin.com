#!/bin/sh
# Guards main. Does NOT deploy - GitHub Actions does that, after the push lands.
#
# This used to ship the site itself. It no longer does: deploying from a developer's laptop
# meant the deploy depended on who pushed and from where, and it ran *before* the refs
# reached the remote. Now the only job here is to stop a broken build from ever becoming
# origin/main, which is cheaper to catch in three seconds locally than in CI.
#
# Escape hatch: SKIP_CHECKS=1 git push
set -e

[ "$SKIP_CHECKS" = "1" ] && { echo "pre-push: SKIP_CHECKS=1, not verifying."; exit 0; }

ZEROS=0000000000000000000000000000000000000000
pushing_main=0

# stdin: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "$ZEROS" ] && continue   # branch deletion, nothing to verify
  pushing_main=1
done

[ "$pushing_main" = "1" ] || exit 0

echo "pre-push: verifying before main..."
npm run lint
npm run check:media
npm run build

echo "pre-push: ok - GitHub Actions will deploy once this lands."
